{
  "name": "hacker-news-crawler",
  "version": "1.0.0",
  "description": "A TypeScript-based Hacker News web crawler",
  "main": "src/main.ts",
  "scripts": {
    "build": "tsc",
    "start": "tsx src/index.ts",
    "lint": "eslint \"src/**/*.ts\"",
    "format": "prettier --write \"src/**/*.ts\"",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "keywords": [],
  "author": "Your Name",
  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.0.0",
    "eslint": "^10.8.1",
    "jest": "^30.0.0",
    "prettier": "^3.9.6",
    "ts-jest": "^29.4.0",
    "ts-node": "^10.9.2",
    "tsx": "^4.23.12",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.67.0",
    "vitest": "^4.1.10"
  },
  "type": "module",
  "dependencies": {
    "cheerio": "^1.2.0"
  }
}
